PORT=3000
# Generate a unique random value of at least 32 characters before starting the backend.
JWT_SECRET=
# Usa memory para el demo o supabase después de aplicar las migraciones.
VERA_PLANNING_STORE=memory
VERA_USER_STORE=memory
VERA_RISK_CONTROL_STORE=memory
VERA_EVIDENCE_COMMENT_STORE=memory
VERA_AUDIT_STORE=memory
VERA_NOTIFICATION_STORE=memory
VERA_ORG_STORE=memory
# New registration/social identity bridge. Keep disabled until migration and providers are configured.
VERA_MANAGED_AUTH_ENABLED=false
VERA_DIRECT_REGISTRATION_ENABLED=false
SUPABASE_PUBLISHABLE_KEY=
VERA_GOOGLE_AUTH_ENABLED=false
VERA_AZURE_AUTH_ENABLED=false
# Clave secreta solo para backend; prefiere la clave nueva sb_secret_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa para proyectos con clave service_role legacy.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para la inicialización manual de un proyecto nuevo; no guardes estos valores en Vercel.
VERA_BOOTSTRAP_ADMIN_NAME=
VERA_BOOTSTRAP_ADMIN_EMAIL=
VERA_BOOTSTRAP_ADMIN_PASSWORD=

# HU-34: backend únicamente. Mantén el interruptor apagado hasta que la base persistente
# y los permisos del despliegue estén verificados. Nunca uses el prefijo VITE_ para la clave.
VERA_AI_ENABLED=false
VERA_AI_CONVERSATIONS_ENABLED=false
VERA_AI_PROJECTS_ENABLED=false
VERA_AI_MEMORY_ENABLED=false
VERA_AI_ATTACHMENTS_ENABLED=false
VERA_AI_PROJECT_FILES_ENABLED=false
VERA_AI_PROJECT_KNOWLEDGE_ENABLED=false
VERA_AI_SEMANTIC_ENABLED=false
VERA_AI_PDF_OCR_ENABLED=false
AZURE_OPENAI_OCR_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
